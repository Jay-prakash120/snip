{
  "name": "@piceofsilicon/snip",
  "version": "1.0.3",
  "description": "A git-inspired CLI tool to create, manage, and export code snippets effortlessly",
  "publishConfig": {
    "access": "public"
  },
  "main": "bin/snip.js",
  "bin": {
    "snip": "bin/snip.js",
    "snip-editor": "bin/snip-editor.js"
  },
  "scripts": {
    "test": "node bin/snip.js --version && node --test",
    "release": "npm test && npm version patch && git push origin master --follow-tags"
  },
  "keywords": [
    "snippets",
    "cli",
    "vscode",
    "antigravity",
    "developer-tools"
  ],
  "author": "Jay Prakash",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jay-prakash120/snip.git"
  },
  "bugs": {
    "url": "https://github.com/Jay-prakash120/snip/issues"
  },
  "homepage": "https://github.com/Jay-prakash120/snip#readme",
  "files": [
    "bin/",
    "commands/",
    "lib/",
    "README.md"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  }
}
